# Used by `docker compose --env-file .env up -d --build`.
# This directory must exist on the Docker host and must not be inside a
# temporary CI/Coolify checkout. It also stores LauncherDockered installations.
PANEL_DATA_DIR=/srv/gravit-panel/data

# ---- Local Development Paths ----
# These defaults match `bun dev`. Compose overrides the storage paths from
# PANEL_DATA_DIR and the published API image already contains agent/runtime
# artifacts under /opt/gravit-panel.
HOST=127.0.0.1
PORT=3000
WEB_HOST=127.0.0.1
DATABASE_PATH=./data/gravit-panel.sqlite
INSTALLATIONS_ROOT=./data/installations
MODULE_ARTIFACTS_DIR=./data/modules

# Build local server-agent artifacts with:
#   bun run build:server-agent:local
# API dev runs with apps/api as its working directory.
SERVER_AGENT_ARTIFACTS_DIR=./data/server-agent

# Optional local override for the prebuilt LauncherRuntime JAR. When omitted,
# the API uses the artifact bundled into the API image or its normal cache.
# PANEL_LAUNCHER_RUNTIME_JAR=./data/launcher-runtime/JavaRuntime.jar

# Built automatically by GitHub Actions. Use sha-<commit> for a pinned rollout.
PANEL_API_IMAGE=ghcr.io/badtochka/gravit-panel-api:latest
PANEL_WEB_IMAGE=ghcr.io/badtochka/gravit-panel-web:latest

# Optional panel self-update through the Coolify API. The token needs only
# deploy permission for this Compose application.
COOLIFY_API_URL=https://coolify.example.com/api/v1
COOLIFY_API_TOKEN=
COOLIFY_APPLICATION_UUID=
# Optional for private repositories or higher GitHub API rate limits. Public
# repositories can check their latest release without this token.
PANEL_UPDATE_GITHUB_TOKEN=

# Repository inspected for the latest published panel release.
PANEL_UPDATE_REPOSITORY=BADtochka/gravit-panel

# Set automatically by the published API image build. Local development should
# normally leave this unset; self-update status will report an unknown revision.
# PANEL_REVISION=<40-character-git-sha>

# Compose binds this only to localhost. Put HTTPS/reverse proxy or SSO in front.
PANEL_PORT=8080

# Optional. Required only if the API is intentionally exposed on another origin.
CORS_ORIGINS=

# Optional. If omitted, the panel generates and persists a key in PANEL_DATA_DIR.
# Generate a replacement with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Optional path for the generated encryption key. Defaults beside DATABASE_PATH.
# CREDENTIAL_ENCRYPTION_KEY_PATH=./data/credential-encryption.key
PUBLIC_PORTAL_HMAC_SECRET=
LAUNCHSERVER_PUBLIC_URL=

# The Compose-visible `launchserver` facade proxies to the one panel-managed
# LauncherDockered runtime. Keep API traffic on this same path.
REMOTE_CONTROL_ENDPOINT=http://launchserver

# Local host port for the facade. Coolify exposes the service directly.
LAUNCHSERVER_PROXY_PORT=9274

# Default address shown during LaunchServer setup. Use the public game domain
# without a scheme or path.
LAUNCHSERVER_PUBLIC_ADDRESS=localhost:9274

# ---- Panel Authentication (Discord OAuth) ----
# Set PANEL_AUTH_MODE=discord to enable authentication. All of the
# PANEL_DISCORD_* variables become required when auth is enabled.
PANEL_AUTH_MODE=disabled

# Public URL of the panel as seen by the browser. This is the single source
# of truth for the panel's address. Its path component (e.g. /panel) drives
# the SPA sub-route AND the OAuth redirect URI.
#
#   Root deployment:  PANEL_PUBLIC_URL=https://panel.example.com
#   Sub-path (Coolify/Traefik stripPrefix):
#                     PANEL_PUBLIC_URL=https://example.com/panel
#
# When set, PANEL_PUBLIC_PATH is derived automatically. You can still set
# PANEL_PUBLIC_PATH explicitly if the proxy strips a different prefix than
# what appears in the URL.
PANEL_PUBLIC_URL=https://panel.example.com

# Legacy/advanced override for the panel OAuth callback. Normally leave unset;
# the callback is derived from PANEL_PUBLIC_URL.
# PANEL_AUTH_REDIRECT_URI=https://panel.example.com/api/panel-auth/callback

# The Discord OAuth callback is derived automatically as
# ${PANEL_PUBLIC_URL}/api/panel-auth/callback.
PANEL_DISCORD_CLIENT_ID=
PANEL_DISCORD_CLIENT_SECRET=
PANEL_DISCORD_ALLOWED_USER_IDS=
PANEL_AUTH_COOKIE_SECURE=true

# Server-only pack workspace upload limits (bytes).
SERVER_PACK_MAX_FILE_BYTES=268435456
SERVER_PACK_MAX_BYTES=4294967296

# Optional override for the SPA sub-path. Derived from PANEL_PUBLIC_URL by
# default. Only set this when the reverse-proxy strips a different prefix
# than the path portion of PANEL_PUBLIC_URL.
# PANEL_PUBLIC_PATH=/panel
