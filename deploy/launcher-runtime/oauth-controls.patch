+        private void copyToClipboard(String value) {
+            try {
+                Clipboard clipboard = Clipboard.getSystemClipboard();
+                ClipboardContent content = new ClipboardContent();
+                content.putString(value);
+                clipboard.setContent(content);
+            } catch (Exception ex) {
+                accessor.errorHandle(ex);
+            }
+        }
+
+        private String queryParameter(String url, String name) {
+            String query = URI.create(url).getRawQuery();
+            if (query == null) return null;
+            for (String item : query.split("&")) {
+                String[] pair = item.split("=", 2);
+                if (pair.length == 2 && name.equals(pair[0])) {
+                    return java.net.URLDecoder.decode(pair[1], java.nio.charset.StandardCharsets.UTF_8);
+                }
+            }
+            return null;
+        }
+
+        private void openExternalBrowser(String url) {
+            if ("LINUX".equals(JVMHelper.OS_TYPE.name())) {
+                if (startBrowserCommand("xdg-open", url)
+                        || startBrowserCommand("gio", "open", url)) {
+                    return;
+                }
+            }
+            try {
+                if (Desktop.isDesktopSupported()
+                        && Desktop.getDesktop().isSupported(Desktop.Action.BROWSE)) {
+                    Desktop.getDesktop().browse(new URI(url));
+                    return;
+                }
+            } catch (Exception ex) {
+                logger.warn("Desktop API failed to open the authorization URL", ex);
+            }
+            if (!application.openURL(url)) {
+                logger.warn("Unable to open the authorization URL automatically; use the copy link button");
+            }
+        }
+
+        private boolean startBrowserCommand(String... command) {
+            try {
+                new ProcessBuilder(command).start();
+                return true;
+            } catch (IOException ex) {
+                logger.debug("Browser command {} is unavailable", command[0], ex);
+                return false;
+            }
+        }
